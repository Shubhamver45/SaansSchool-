# SaansSchool Cloud & Ground Station Configuration

# 1. World Air Quality Index (WAQI / CPCB / EPA Ground Stations)
# Free instant token at: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=

# 2. OpenWeatherMap Air Pollution API Key
# Free key at: https://openweathermap.org/api/air-pollution
OPENWEATHER_API_KEY=

# 3. AWS Cloud Credentials (for DynamoDB, Polly & Bedrock)
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_DEFAULT_REGION=ap-south-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
DYNAMODB_STATUS_TABLE=SaansSchoolDailyStatus
DYNAMODB_AUDIT_TABLE=SaansSchoolActionAudit
